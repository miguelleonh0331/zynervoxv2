[zynervoxv2]
user = apache
group = apache
listen = /run/php-fpm/zynervoxv2.sock
listen.owner = apache
listen.group = apache
listen.mode = 0660
pm = ondemand
pm.max_children = 12
pm.process_idle_timeout = 10s
security.limit_extensions = .php
php_admin_value[auto_prepend_file] = __WEB_ROOT__/includes/IsolatedGate.php
php_admin_value[user_ini.filename] =
php_admin_flag[display_errors] = off
php_admin_flag[log_errors] = on
