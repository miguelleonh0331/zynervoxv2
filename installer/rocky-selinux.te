module zynervox 1.0;

require {
    type httpd_t;
    type asterisk_t;
    type httpd_sys_content_t;
    attribute file_type;
    class dir { add_name create getattr open read remove_name rmdir search setattr write };
    class file { append create execute execute_no_trans getattr ioctl lock map open read rename setattr unlink write };
    class lnk_file { getattr read };
}

type zynervox_runtime_t;
typeattribute zynervox_runtime_t file_type;
type zynervox_conf_t;
typeattribute zynervox_conf_t file_type;
type zynervox_agi_exec_t;
typeattribute zynervox_agi_exec_t file_type;

allow { httpd_t asterisk_t } zynervox_runtime_t:dir { add_name create getattr open read remove_name rmdir search setattr write };
allow { httpd_t asterisk_t } zynervox_runtime_t:file { append create getattr ioctl lock map open read rename setattr unlink write };
allow { httpd_t asterisk_t } zynervox_runtime_t:lnk_file { getattr read };
allow { httpd_t asterisk_t } zynervox_conf_t:dir { getattr open read search };
allow { httpd_t asterisk_t } zynervox_conf_t:file { getattr ioctl map open read };
allow asterisk_t httpd_sys_content_t:dir { getattr open read search };
allow asterisk_t httpd_sys_content_t:file { getattr ioctl map open read };
allow asterisk_t httpd_sys_content_t:lnk_file { getattr read };
allow { httpd_t asterisk_t } zynervox_agi_exec_t:file { getattr ioctl map open read };
allow asterisk_t zynervox_agi_exec_t:file { execute execute_no_trans };
